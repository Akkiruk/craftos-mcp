{
  "name": "craftos-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Planning-first workspace for a local, MCP-enabled CC:Tweaked test environment.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run format:check && npm run typecheck && npm test",
    "clean": "tsc -b --clean",
    "dev": "npm run dev --workspace=@craftos-mcp/mcp-server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "start": "npm run start --workspace=@craftos-mcp/mcp-server",
    "test": "vitest run",
    "build:web": "node web/build-runtime.mjs && node web/build-carts.mjs",
    "test:web": "node web/test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
